# ===== 应用配置 =====
APP_NAME=AI Workbench
# 生产环境必须设置；留空表示不开启 API Key 鉴权（仅限本地开发）
API_KEY=

# 跨域白名单（JSON 数组格式，如 ["http://localhost:8080"]）。
# 留空 = 仅同源访问，浏览器跨域请求会被拒绝。生产环境请保持留空或填精确域名。
CORS_ORIGINS=

# ===== LLM 配置（OpenAI 兼容接口，可替换为任意兼容服务）=====
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-4o-mini
#EMBEDDING_MODEL=text-embedding-3-small
#VISION_MODEL=gpt-4o
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=qwen2.5-7b
EMBEDDING_MODEL=text-embedding-bge-m3
VISION_MODEL=gpt-4o

# ===== RAG 配置 =====
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=4

# ===== Agent 配置 =====
AGENT_MAX_STEPS=8
AGENT_CODE_TIMEOUT=10
# query_database 工具使用的 SQLite 数据库路径
SQLITE_PATH=data/demo.db
# 是否启用 run_python 工具（任意代码执行能力，默认关闭；开启前请评估风险）
ENABLE_PYTHON_TOOL=false

# ===== 服务配置 =====
DATA_DIR=data
MAX_UPLOAD_MB=20
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MINUTE=60
# 工作流整体执行超时（秒）
WORKFLOW_TIMEOUT_SECONDS=120
